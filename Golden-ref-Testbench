`timescale 1ns/1ps

module uart_tb;

    parameter CLKS_PER_BIT = 16;
    reg clk = 0,reset = 0, tx_start = 0;
    reg [7:0] tx_data = 0;
    wire tx, tx_busy, tx_done,rx_valid, rx_busy, rx_error;
    wire [7:0] rx_data;
    integer i,errors = 0,cycles;
    uart_top #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) dut (
        .clk(clk),
        .reset(reset),
        .tx_start(tx_start),
        .rx(tx),
        .tx_data(tx_data),
        .tx(tx),
        .tx_busy(tx_busy),
        .tx_done(tx_done),
        .rx_valid(rx_valid),
        .rx_busy(rx_busy),
        .rx_error(rx_error),
        .rx_data(rx_data)
    );

    always #5 clk = ~clk;

    initial begin
        repeat (5) @(negedge clk);
        reset = 1;

        for (i = 0; i < 256; i = i + 1) begin
            wait (tx_busy == 1'b0);
            @(negedge clk);
            tx_data = i;
            tx_start = 1;
            @(negedge clk);
            tx_start = 0;
            cycles = 0;
          // second cond is for checking timeout errors like 0 bits need 10 bit periods each bit period is like 16 clock cycles(clks_per_bits is 16) and 2 bit for code delay etc
            while (rx_valid !== 1'b1 && cycles < CLKS_PER_BIT * 12) begin
                @(negedge clk);
                cycles = cycles + 1;
            end

          if (rx_valid !== 1'b1) begin // not != because it is ordinary inequality and can produce X if unknown values affect the comparison.
            // for pure 0 1 X Z compairsion we need !==
            $display("TIMEOUT: sent=%0d", i);
            errors = errors + 1;
            end
            else if (rx_data !== i[7:0]) begin
            $display("FAIL: sent=%0d received=%0d", i, rx_data);
            errors = errors + 1;
            end
            else begin
            $display("PASS: sent=%0d received=%0d", i, rx_data);
            end

            wait (tx_busy == 1'b0);
          @(negedge clk); // waiting negedge because use negedge clk in the testbench to change inputs away from the positive edge where the DUT samples them. This avoids race conditions and ensures stable inputs at the sampling edge.
        end
        if (errors == 0)
            $display("PASS");
        else
            $display("FAIL: %0d errors out of 256 tests.", errors);
        $finish;
    end
    initial begin
        #10000000; // if simulation runs this long automatically stop as that means design code wrong 
// it runs parallel and races with first initial block
      $display("TLE");
        $finish;
    end

endmodule
